# Ollama Cloud API key — obtain from https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here

# Ollama Cloud base URL (default is shown below; change only if using a self-hosted endpoint)
OLLAMA_BASE_URL=https://api.ollama.com

# Port the server listens on (optional; defaults to 8000)
# PORT=8000
